{
  "name": "@tlning260310/dsh-researcher",
  "version": "0.8.0-alpha.10-dev.0",
  "private": true,
  "description": "Read-only project research, durable project cognition, and evidence-gated definitions of done for AI coding agents on DeepSeek Harness.",
  "author": "TLNing260310",
  "license": "MIT",
  "main": "lib/index.js",
  "bin": {
    "dsh-researcher": "bin/install.js",
    "project-cognition": "bin/project-cognition.js",
    "researcher-feedback": "bin/feedback.js"
  },
  "files": [
    "bin/",
    "lib/",
    "researcher/",
    "governed/",
    "schemas/",
    "examples/",
    "docs/",
    "fixtures/",
    "scripts/",
    "tests/",
    "evaluation/selection_result.json",
    "evaluation/random_seed.txt",
    "evaluation/cases/commander.js/gt-calibration/experiment-cplus-validity.json",
    "evaluation/results/experiment-a/analysis-report.md",
    "evaluation/results/experiment-a/limitations.md",
    "evaluation/results/experiment-a/score-report.json",
    "evaluation/results/experiment-cplus/analysis-report.md",
    "evaluation/results/experiment-cplus/limitations.md",
    "evaluation/results/experiment-cplus/score-report.json",
    "evaluation/goal-governor-e1/",
    "release/current.json",
    ".project-cognition/state.json",
    ".project-cognition/verifiers.json",
    "PROJECT_COGNITION.md",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "demo": "node scripts/demo-governor.js",
    "test": "node --test tests/*.test.js",
    "doctor": "node bin/project-cognition.js doctor . && node bin/project-cognition.js adapter doctor governed/adapter-manifest.json",
    "cognition:freshness": "node scripts/check-cognition-freshness.js",
    "adapter:discovery:check": "node scripts/check-adapter-discovery.js",
    "adapter:discovery:capture:claude": "node scripts/capture-claude-agent-sdk-discovery.js",
    "eval:e1:capture-tools": "node evaluation/goal-governor-e1/capture-visible-tools.js",
    "eval:e1:attest": "node evaluation/goal-governor-e1/attest-e1.js",
    "eval:e1:lock": "node evaluation/goal-governor-e1/lock.js",
    "eval:e1:preflight": "node evaluation/goal-governor-e1/preflight.js",
    "eval:e1:score": "node evaluation/goal-governor-e1/score-e1.js",
    "eval:e1:live": "node evaluation/goal-governor-e1/run-e1.js --mode live",
    "release:artifacts": "node scripts/build-release-artifacts.js",
    "check": "npm test && npm run doctor && npm run cognition:freshness && npm run adapter:discovery:check && npm run eval:e1:preflight"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "ai-coding",
    "ai-agent",
    "coding-agent",
    "agent-memory",
    "developer-tools",
    "definition-of-done",
    "architecture-drift",
    "llm-evaluation",
    "project-cognition",
    "goal-governor",
    "research-agent",
    "agent-governance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TLNing260310/dsh-researcher.git"
  },
  "homepage": "https://github.com/TLNing260310/dsh-researcher#readme",
  "bugs": {
    "url": "https://github.com/TLNing260310/dsh-researcher/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
