{
  "schema": "dsh-researcher/expected-host-events/v1",
  "client": "claude-code-agent-sdk",
  "binding_provenance_path": "binding-provenance.json",
  "event_cohesion_path": "event-cohesion.json",
  "mappings": [
    {
      "native": "PreToolUse",
      "host_kind": "tool_call",
      "required_bindings": ["session_id", "tool_use_id", "tool input hash"],
      "normalized_bindings": {
        "session_id": { "status": "DOCUMENTED", "native": "session_id", "proof": "base-hook.session-id" },
        "turn_id": { "status": "DOCUMENTED", "native": "prompt_id", "proof": "base-hook.prompt-id" },
        "call_id": { "status": "DOCUMENTED", "native": "tool_use_id", "proof": "pre-tool-use.tool-use-id" },
        "arguments_sha256": { "status": "DOCUMENTED", "native": "tool_input canonical hash", "proof": "pre-tool-use.tool-input" }
      }
    },
    {
      "native": "PostToolUse|PostToolUseFailure",
      "host_kind": "tool_result",
      "required_bindings": ["session_id", "tool_use_id", "result hash", "failure status"],
      "normalized_bindings": {
        "session_id": { "status": "DOCUMENTED", "native": "session_id", "proof": "base-hook.session-id" },
        "turn_id": { "status": "DOCUMENTED", "native": "prompt_id", "proof": "base-hook.prompt-id" },
        "call_id": { "status": "DOCUMENTED", "native": "tool_use_id", "proof": "post-tool-use.tool-use-id" },
        "result_sha256": { "status": "DOCUMENTED", "native": "tool_response|error canonical hash", "proof": "post-tool-use.tool-response" },
        "terminal_status": { "status": "DOCUMENTED", "native": "PostToolUse|PostToolUseFailure discriminator", "proof": "post-tool-use.outcome-discriminator" }
      }
    },
    {
      "native": "PermissionRequest + canUseTool response",
      "host_kind": "user_action",
      "required_bindings": ["session_id", "tool_use_id", "request id", "principal", "decision receipt"],
      "normalized_bindings": {
        "session_id": { "status": "DOCUMENTED", "native": "session_id", "proof": "base-hook.session-id" },
        "turn_id": { "status": "DOCUMENTED", "native": "prompt_id", "proof": "base-hook.prompt-id" },
        "call_id": { "status": "DOCUMENTED", "native": "CanUseTool.options.toolUseID", "proof": "can-use-tool.tool-use-id" },
        "request_id": { "status": "DOCUMENTED", "native": "CanUseTool.options.requestId", "proof": "can-use-tool.request-id" },
        "principal_id": { "status": "GAP", "native": null, "proof": null },
        "decision_receipt": { "status": "DOCUMENTED", "native": "PermissionResult.behavior + decisionClassification", "proof": "permission-result.decision" }
      }
    },
    {
      "native": "SDKResultMessage.modelUsage",
      "host_kind": "usage",
      "required_bindings": ["session_id", "turn correlation", "cumulative delta"],
      "normalized_bindings": {
        "session_id": { "status": "DOCUMENTED", "native": "session_id", "proof": "result.session-id" },
        "turn_id": { "status": "DOCUMENTED", "native": "user_message_uuid", "proof": "result.user-message-uuid" },
        "usage_delta": { "status": "DOCUMENTED", "native": "modelUsage cumulative delta", "proof": "result.model-usage" },
        "coverage_complete": { "status": "GAP", "native": null, "proof": null }
      }
    },
    {
      "native": "SDKResultMessage",
      "host_kind": "turn_end",
      "required_bindings": ["session_id", "result subtype"],
      "normalized_bindings": {
        "session_id": { "status": "DOCUMENTED", "native": "session_id", "proof": "result.session-id" },
        "turn_id": { "status": "DOCUMENTED", "native": "user_message_uuid", "proof": "result.user-message-uuid" },
        "terminal_status": { "status": "DOCUMENTED", "native": "result subtype + terminal_reason", "proof": "result.terminal-status" }
      }
    },
    {
      "native": "SessionStart source=resume",
      "host_kind": "session_resume",
      "required_bindings": ["session_id", "prefix checkpoint hash"],
      "normalized_bindings": {
        "session_id": { "status": "DOCUMENTED", "native": "session_id", "proof": "session-start.session-id" },
        "resume_prefix_sha256": { "status": "GAP", "native": null, "proof": null }
      }
    },
    {
      "native": "Query.interrupt receipt + Stop",
      "host_kind": "goal_transition",
      "required_bindings": ["session_id", "interrupt receipt", "terminal observation"],
      "normalized_bindings": {
        "session_id": { "status": "DOCUMENTED", "native": "session_id", "proof": "stop-hook.session-id" },
        "turn_id": { "status": "DOCUMENTED", "native": "prompt_id", "proof": "base-hook.prompt-id" },
        "interrupt_receipt": { "status": "DOCUMENTED", "native": "SDKControlInterruptResponse", "proof": "query.interrupt-receipt" },
        "terminal_status": { "status": "DOCUMENTED", "native": "Stop hook_event_name", "proof": "stop-hook.discriminator" }
      }
    }
  ]
}
