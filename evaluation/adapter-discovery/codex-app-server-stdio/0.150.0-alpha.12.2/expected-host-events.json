{
  "schema": "dsh-researcher/expected-host-events/v1",
  "client": "codex-app-server-stdio",
  "binding_provenance_path": "binding-provenance.json",
  "mappings": [
    {
      "native": "item/started commandExecution|fileChange|dynamicToolCall",
      "host_kind": "tool_call",
      "required_bindings": ["threadId", "turnId", "item.id", "arguments hash"],
      "normalized_bindings": {
        "session_id": { "status": "DOCUMENTED", "native": "threadId", "proof": "item-started.thread-id" },
        "turn_id": { "status": "DOCUMENTED", "native": "turnId", "proof": "item-started.turn-id" },
        "call_id": { "status": "DOCUMENTED", "native": "item.id", "proof": "item.id" },
        "arguments_sha256": { "status": "DOCUMENTED", "native": "item input canonical hash", "proof": "item.input" }
      }
    },
    {
      "native": "item/completed commandExecution|fileChange|dynamicToolCall",
      "host_kind": "tool_result",
      "required_bindings": ["threadId", "turnId", "item.id", "result hash", "terminal status"],
      "normalized_bindings": {
        "session_id": { "status": "DOCUMENTED", "native": "threadId", "proof": "item-completed.thread-id" },
        "turn_id": { "status": "DOCUMENTED", "native": "turnId", "proof": "item-completed.turn-id" },
        "call_id": { "status": "DOCUMENTED", "native": "item.id", "proof": "item.id" },
        "result_sha256": { "status": "DOCUMENTED", "native": "item output canonical hash", "proof": "item.output" },
        "terminal_status": { "status": "DOCUMENTED", "native": "item status", "proof": "item.status" }
      }
    },
    {
      "native": "item/*/requestApproval + JSON-RPC response",
      "host_kind": "user_action",
      "required_bindings": ["request id", "threadId", "turnId", "itemId", "principal", "decision receipt"],
      "normalized_bindings": {
        "session_id": { "status": "DOCUMENTED", "native": "threadId", "proof": "approval.thread-id" },
        "turn_id": { "status": "DOCUMENTED", "native": "turnId", "proof": "approval.turn-id" },
        "call_id": { "status": "DOCUMENTED", "native": "itemId", "proof": "approval.item-id" },
        "request_id": { "status": "DOCUMENTED", "native": "JSON-RPC request id", "proof": "json-rpc.request-id" },
        "principal_id": { "status": "GAP", "native": null, "proof": null },
        "decision_receipt": { "status": "DOCUMENTED", "native": "JSON-RPC response result", "proof": "approval.response" }
      }
    },
    {
      "native": "thread/tokenUsage/updated",
      "host_kind": "usage",
      "required_bindings": ["threadId", "turnId", "last", "total"],
      "normalized_bindings": {
        "session_id": { "status": "DOCUMENTED", "native": "threadId", "proof": "token-usage.thread-id" },
        "turn_id": { "status": "DOCUMENTED", "native": "turnId", "proof": "token-usage.turn-id" },
        "usage_delta": { "status": "DOCUMENTED", "native": "tokenUsage.last + total", "proof": "token-usage.counters" },
        "coverage_complete": { "status": "GAP", "native": null, "proof": null }
      }
    },
    {
      "native": "turn/completed",
      "host_kind": "turn_end",
      "required_bindings": ["threadId", "turn.id", "turn.status"],
      "normalized_bindings": {
        "session_id": { "status": "DOCUMENTED", "native": "threadId", "proof": "turn-completed.thread-id" },
        "turn_id": { "status": "DOCUMENTED", "native": "turn.id", "proof": "turn.id" },
        "terminal_status": { "status": "DOCUMENTED", "native": "turn.status", "proof": "turn.status" }
      }
    },
    {
      "native": "thread/resume response",
      "host_kind": "session_resume",
      "required_bindings": ["thread.id", "prefix checkpoint hash"],
      "normalized_bindings": {
        "session_id": { "status": "DOCUMENTED", "native": "thread.id", "proof": "thread-resume.thread-id" },
        "resume_prefix_sha256": { "status": "GAP", "native": null, "proof": null }
      }
    },
    {
      "native": "turn/interrupt response + terminal turn",
      "host_kind": "goal_transition",
      "required_bindings": ["threadId", "turnId", "interrupt receipt"],
      "normalized_bindings": {
        "session_id": { "status": "DOCUMENTED", "native": "threadId", "proof": "turn-interrupt.thread-id" },
        "turn_id": { "status": "DOCUMENTED", "native": "turnId", "proof": "turn-interrupt.turn-id" },
        "interrupt_receipt": { "status": "DOCUMENTED", "native": "JSON-RPC turn/interrupt response", "proof": "turn-interrupt.response" },
        "terminal_status": { "status": "DOCUMENTED", "native": "turn/completed turn.status", "proof": "turn.status" }
      }
    }
  ]
}
