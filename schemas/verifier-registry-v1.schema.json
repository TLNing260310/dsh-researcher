{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-cognition/verifier-registry/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "registry_hash", "entries"],
  "properties": {
    "schema": { "const": "project-cognition/verifier-registry/v1" },
    "revision": { "type": "integer", "minimum": 1 },
    "registry_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "invocations", "result_policy"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
          "invocations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["tool_name", "arguments", "arguments_hash"],
              "properties": {
                "tool_name": { "type": "string", "minLength": 1 },
                "arguments": { "type": "object" },
                "arguments_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            }
          },
          "result_policy": {
            "oneOf": [
              { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "tool_success" } } },
              { "type": "object", "additionalProperties": false, "required": ["kind", "path", "equals"], "properties": { "kind": { "const": "json_field_equals" }, "path": { "type": "string", "minLength": 1 }, "equals": { "type": ["string", "number", "boolean", "null"] } } },
              { "type": "object", "additionalProperties": false, "required": ["kind", "patterns"], "properties": { "kind": { "const": "text_excludes" }, "patterns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } } }
            ]
          }
        }
      }
    }
  }
}
