{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsh-researcher/evidence-sources/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "required_fresh", "entries"],
  "properties": {
    "schema": { "const": "dsh-researcher/evidence-sources/v1" },
    "required_fresh": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "files"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
