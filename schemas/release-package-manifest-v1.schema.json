{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsh-researcher/release-package-manifest/v1",
  "title": "dsh-researcher release package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "package", "files"],
  "properties": {
    "schema": { "const": "dsh-researcher/release-package-manifest/v1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_revision", "worktree_clean"],
      "properties": {
        "git_revision": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "worktree_clean": { "type": "boolean" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "filename", "sha256", "npm_shasum_sha1", "npm_integrity_sha512", "size", "unpacked_size", "entry_count", "node_requirement"],
      "properties": {
        "name": { "const": "dsh-researcher" },
        "version": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "pattern": "^dsh-researcher-.+\\.tgz$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "npm_shasum_sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "npm_integrity_sha512": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$" },
        "size": { "type": "integer", "minimum": 1 },
        "unpacked_size": { "type": "integer", "minimum": 1 },
        "entry_count": { "type": "integer", "minimum": 1 },
        "node_requirement": { "type": "string", "minLength": 1 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "mode"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 0 },
          "mode": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
